{
    "zabbix_export": {
        "version": "7.0",
        "template_groups": [
            {
                "uuid": "268c5b3c9710469e841443fa2be502e6",
                "name": "Templates/IoT"
            }
        ],
        "templates": [
            {
                "uuid": "6b2015ff917b4e1bb3c5b823c2efe945",
                "template": "ESP32 Self-Monitoring",
                "name": "ESP32 Self-Monitoring",
                "description": "Monitors internal health metrics of an ESP32 microcontroller running the zabbix-obd2 firmware.\n\nMetrics are sent via Zabbix Trapper every 10 seconds by the firmware itself.\n\nKeys collected:\n  esp32.heap.free       - Free heap memory (bytes)\n  esp32.heap.total      - Total heap size (bytes)\n  esp32.heap.min_free   - Minimum free heap since boot (bytes)\n  esp32.heap.max_alloc  - Largest contiguous allocatable block (bytes)\n  esp32.heap.used_pct   - Heap used percentage (%)\n  esp32.wifi.rssi       - Wi-Fi signal strength (dBm)\n  esp32.wifi.channel    - Wi-Fi channel\n  esp32.uptime          - Device uptime (seconds)\n  esp32.cpu.freq        - CPU frequency (MHz)\n  esp32.tasks           - Number of active FreeRTOS tasks\n  esp32.chip.temp       - Internal chip temperature (°C)\n  esp32.reset_reason    - Last reset reason code (esp_reset_reason_t)",
                "groups": [
                    {
                        "name": "Templates/IoT"
                    }
                ],
                "items": [
                    {
                        "uuid": "a0861e279be8484bbb5d1b8a7e7fd244",
                        "name": "Heap Free",
                        "type": "TRAP",
                        "key": "esp32.heap.free",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Amount of free heap memory available to the firmware (bytes).",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "0f301d4e60594880b49331a5840a25e6",
                                "expression": "last(/ESP32 Self-Monitoring/esp32.heap.free)<{$ESP32.HEAP.FREE.MIN}",
                                "name": "ESP32 heap critically low ({ITEM.LASTVALUE})",
                                "priority": "HIGH",
                                "description": "Free heap dropped below the minimum safe threshold. The firmware may crash soon due to memory exhaustion.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "3d6c13c17285419381611f213232d497",
                        "name": "Heap Total",
                        "type": "TRAP",
                        "key": "esp32.heap.total",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Total heap size available to the firmware (bytes). Constant after boot.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "037302455e144fb3a544708fbe50f3d4",
                        "name": "Heap Min Free (since boot)",
                        "type": "TRAP",
                        "key": "esp32.heap.min_free",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "The lowest value that free heap has ever reached since the last boot. Useful for detecting memory pressure over time.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "68e003d38cd044cd920281c834e3525e",
                        "name": "Heap Max Allocatable Block",
                        "type": "TRAP",
                        "key": "esp32.heap.max_alloc",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Largest single contiguous block that can be allocated from heap. Indicates heap fragmentation when much lower than esp32.heap.free.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "1ca1a4679f0d4bcfa06d81b7f91bc7fb",
                        "name": "Heap Used",
                        "type": "TRAP",
                        "key": "esp32.heap.used_pct",
                        "delay": "0",
                        "value_type": "FLOAT",
                        "units": "%",
                        "description": "Percentage of heap memory currently in use. Calculated by the firmware as 100 * (1 - free/total).",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "ae5af8f3a4b64329b174e6af9dbcf7ae",
                                "expression": "last(/ESP32 Self-Monitoring/esp32.heap.used_pct)>{$ESP32.HEAP.USED.HIGH}",
                                "name": "ESP32 heap usage high ({ITEM.LASTVALUE})",
                                "priority": "WARNING",
                                "description": "Heap usage exceeded the warning threshold.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "capacity"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "3fea6be4f5664bdf82fc280ef7ec122e",
                        "name": "Wi-Fi Signal (RSSI)",
                        "type": "TRAP",
                        "key": "esp32.wifi.rssi",
                        "delay": "0",
                        "value_type": "FLOAT",
                        "units": "dBm",
                        "description": "Wi-Fi received signal strength indicator. Values closer to 0 dBm indicate a stronger signal.\nTypical ranges:\n  -30 to -50 dBm = Excellent\n  -50 to -65 dBm = Good\n  -65 to -75 dBm = Fair\n  -75 to -90 dBm = Weak",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "bf6b38fcf253495b942e4f3b09f88698",
                                "expression": "last(/ESP32 Self-Monitoring/esp32.wifi.rssi)<{$ESP32.WIFI.RSSI.MIN}",
                                "name": "ESP32 Wi-Fi signal weak ({ITEM.LASTVALUE} dBm)",
                                "priority": "WARNING",
                                "description": "Wi-Fi signal strength dropped below the threshold. Data delivery to Zabbix may be unreliable.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "93088d8af5ba4b86bb5b5f3ec408530a",
                        "name": "Wi-Fi Channel",
                        "type": "TRAP",
                        "key": "esp32.wifi.channel",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Wi-Fi channel currently in use.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "633787377a4b4142a282469d51880b9a",
                        "name": "Uptime",
                        "type": "TRAP",
                        "key": "esp32.uptime",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "s",
                        "description": "Time elapsed since the ESP32 last booted, in seconds.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "system"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "9f0a80a089814065ab6737e9690975af",
                                "expression": "change(/ESP32 Self-Monitoring/esp32.uptime)<0",
                                "name": "ESP32 rebooted (uptime reset detected)",
                                "priority": "WARNING",
                                "description": "The uptime counter decreased, indicating the ESP32 was rebooted. Check esp32.reset_reason for the cause.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "74b15bc211c9468cbef9c54545df7216",
                        "name": "CPU Frequency",
                        "type": "TRAP",
                        "key": "esp32.cpu.freq",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "MHz",
                        "description": "Current CPU clock frequency. Typically 240 MHz on ESP32 WROOM-32.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "cpu"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "ffadabf6868b4361be4560c1adce1fdf",
                        "name": "FreeRTOS Task Count",
                        "type": "TRAP",
                        "key": "esp32.tasks",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Number of active FreeRTOS tasks currently running on the ESP32.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "rtos"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "63c9da0c978b497e915ca991f8b00115",
                        "name": "Internal Chip Temperature",
                        "type": "TRAP",
                        "key": "esp32.chip.temp",
                        "delay": "0",
                        "value_type": "FLOAT",
                        "units": "°C",
                        "description": "Internal temperature sensor of the ESP32 chip. Note: this sensor has low accuracy (±5°C) and measures die temperature, not ambient.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "thermal"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "d3e2b10546e840da815bc5e189562c86",
                                "expression": "last(/ESP32 Self-Monitoring/esp32.chip.temp)>{$ESP32.TEMP.HIGH}",
                                "name": "ESP32 chip temperature high ({ITEM.LASTVALUE}°C)",
                                "priority": "WARNING",
                                "description": "ESP32 internal die temperature exceeded the warning threshold. Consider improving ventilation around the board.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "78f4c6c7a72046d288a5b178a51fcccf",
                        "name": "Last Reset Reason",
                        "type": "TRAP",
                        "key": "esp32.reset_reason",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Numeric code of the last reset reason (esp_reset_reason_t):\n  1 = Power-on reset\n  2 = External pin reset\n  3 = Software reset (ESP.restart())\n  4 = Exception / panic\n  5 = Interrupt watchdog\n  6 = Task watchdog\n  7 = Other watchdog\n  8 = Brownout (low voltage)\n  9 = SDIO reset",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "system"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "f72decded35e4104822c99988de03d50",
                                "expression": "last(/ESP32 Self-Monitoring/esp32.reset_reason)=4 or last(/ESP32 Self-Monitoring/esp32.reset_reason)=5 or last(/ESP32 Self-Monitoring/esp32.reset_reason)=6 or last(/ESP32 Self-Monitoring/esp32.reset_reason)=8",
                                "name": "ESP32 rebooted due to fault (reason={ITEM.LASTVALUE})",
                                "priority": "HIGH",
                                "description": "The ESP32 rebooted due to a fault condition: panic/exception (4), interrupt watchdog (5), task watchdog (6), or brownout (8).",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "86ba9172a51c49ce8ae2b7df3b99ed6e",
                        "name": "Flash Total Size",
                        "type": "TRAP",
                        "key": "esp32.flash.total",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Total flash chip size on the ESP32 board.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "flash"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "7e0266adaa7149538fbc938348a60a21",
                        "name": "Flash Sketch Size",
                        "type": "TRAP",
                        "key": "esp32.flash.sketch_size",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Size of the currently uploaded firmware sketch in bytes.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "flash"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "b1ec58df4a9b47249f2da0b2b58e9247",
                        "name": "Flash Free Space (OTA)",
                        "type": "TRAP",
                        "key": "esp32.flash.free_space",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Free flash space available for OTA firmware updates.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "flash"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "0cb7890374a74bb6b05fdc6704738e6e",
                                "expression": "last(/ESP32 Self-Monitoring/esp32.flash.free_space)<{$ESP32.FLASH.FREE.MIN}",
                                "name": "ESP32 free flash space low ({ITEM.LASTVALUE})",
                                "priority": "WARNING",
                                "description": "Available flash space for OTA updates dropped below the threshold. A firmware update may not be possible.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "capacity"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "e39b7355826d44ab9a287a2460ebfa05",
                        "name": "PSRAM Total",
                        "type": "TRAP",
                        "key": "esp32.psram.total",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Total PSRAM size. Returns 0 on boards without PSRAM (e.g. WROOM-32). Non-zero on WROVER variants.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "11dca90f5ec142c8b3b420687f7d30e3",
                        "name": "PSRAM Free",
                        "type": "TRAP",
                        "key": "esp32.psram.free",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "units": "B",
                        "description": "Free PSRAM available. Returns 0 on boards without PSRAM.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "memory"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "9de0d0f880e34a5ab201caf36915501d",
                        "name": "OBD2 Bluetooth Connected",
                        "type": "TRAP",
                        "key": "esp32.obd2.bt_connected",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Indicates whether the ESP32 is currently connected to the ELM327 adapter via Bluetooth.\n1 = Connected, 0 = Disconnected.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "obd2"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "148e587869de4bb9a4ccb5a5db22297b",
                                "expression": "max(/ESP32 Self-Monitoring/esp32.obd2.bt_connected,5m)=0",
                                "name": "ESP32 OBD2 Bluetooth disconnected for >5 minutes",
                                "priority": "WARNING",
                                "description": "The ESP32 has not been connected to the ELM327 adapter for over 5 minutes. No vehicle telemetry is being collected.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "71a88e583c0d41a89b316072a76bceab",
                        "name": "OBD2 Active PIDs",
                        "type": "TRAP",
                        "key": "esp32.obd2.active_pids",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Number of OBD2 PIDs currently being actively polled from the ECU. Set to 0 when Bluetooth is disconnected.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "obd2"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ]
                    },
                    {
                        "uuid": "7016e318aea0497caef90fe9c153e007",
                        "name": "OBD2 Failed PID Reads",
                        "type": "TRAP",
                        "key": "esp32.obd2.failed_reads",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Cumulative count of PID queries that returned no valid data since last reboot. A steadily increasing value may indicate ECU communication issues.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "obd2"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "b4d2bf63085248d39f82764b6d0bd9e5",
                                "expression": "change(/ESP32 Self-Monitoring/esp32.obd2.failed_reads)>{$ESP32.OBD2.FAILED.RATE}",
                                "name": "ESP32 OBD2 PID read failures increasing rapidly",
                                "priority": "WARNING",
                                "description": "The rate of failed PID reads increased by more than the threshold in a single interval. Possible ECU or adapter communication issue.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "4d6c4c3386754d00890dc9de62895a0d",
                        "name": "Connection Reconnect Count",
                        "type": "TRAP",
                        "key": "esp32.obd2.reconnects",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Cumulative number of Wi-Fi and Bluetooth reconnection attempts since last reboot. A high value indicates an unstable connection environment.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "603a0859754a47b38de4c4db15dafc3a",
                                "expression": "change(/ESP32 Self-Monitoring/esp32.obd2.reconnects)>0 and timeleft(/ESP32 Self-Monitoring/esp32.uptime,1h,0)<3600",
                                "name": "ESP32 reconnection detected",
                                "priority": "INFO",
                                "description": "A Wi-Fi or Bluetooth reconnection occurred. Check esp32.reset_reason if this happens frequently.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "b232e118737f47e18c3f3244f05fa3c6",
                        "name": "Zabbix Send Errors",
                        "type": "TRAP",
                        "key": "esp32.zabbix.send_errors",
                        "delay": "0",
                        "value_type": "UNSIGNED",
                        "description": "Cumulative number of failed TCP connection attempts to the Zabbix server since last reboot. A non-zero value indicates network or server availability issues.",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "zabbix"
                            },
                            {
                                "tag": "device",
                                "value": "esp32"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "0ecc6a8b6a404fc28816d8ffd7fcae26",
                                "expression": "change(/ESP32 Self-Monitoring/esp32.zabbix.send_errors)>0",
                                "name": "ESP32 failed to send data to Zabbix",
                                "priority": "WARNING",
                                "description": "At least one TCP connection to the Zabbix server failed. Telemetry data may have been lost.",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "macros": [
                    {
                        "macro": "{$ESP32.HEAP.FREE.MIN}",
                        "value": "30000",
                        "description": "Minimum acceptable free heap in bytes before triggering a HIGH alert (default: 30 KB)"
                    },
                    {
                        "macro": "{$ESP32.HEAP.USED.HIGH}",
                        "value": "80",
                        "description": "Heap used percentage threshold for WARNING alert (default: 80%)"
                    },
                    {
                        "macro": "{$ESP32.WIFI.RSSI.MIN}",
                        "value": "-80",
                        "description": "Minimum acceptable Wi-Fi RSSI in dBm before triggering a WARNING alert (default: -80 dBm)"
                    },
                    {
                        "macro": "{$ESP32.TEMP.HIGH}",
                        "value": "80",
                        "description": "Chip temperature threshold in °C for WARNING alert (default: 80°C)"
                    },
                    {
                        "macro": "{$ESP32.FLASH.FREE.MIN}",
                        "value": "524288",
                        "description": "Minimum acceptable free flash space for OTA in bytes (default: 512 KB)"
                    },
                    {
                        "macro": "{$ESP32.OBD2.FAILED.RATE}",
                        "value": "10",
                        "description": "Maximum acceptable increase in failed PID reads per 10s interval before triggering a WARNING"
                    }
                ]
            }
        ]
    }
}