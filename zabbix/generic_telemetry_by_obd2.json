{
    "zabbix_export": {
        "version": "7.0",
        "template_groups": [
            {
                "uuid": "63d7d43db3d940ebad910df7768fa881",
                "name": "Templates/Automotive"
            }
        ],
        "templates": [
            {
                "uuid": "66780197a70f4af280bf0d641eb915a2",
                "template": "Generic Telemetry by OBD2",
                "name": "Generic Telemetry by OBD2",
                "description": "A generic Zabbix template for vehicle telemetry using the OBD2 standard (SAE J1979). Uses LLD to dynamically discover supported PIDs. Configurable for different cars via macros.",
                "groups": [
                    {
                        "name": "Templates/Automotive"
                    }
                ],
                "items": [
                    {
                        "uuid": "891930e529024c35bcc9ba503a594cf4",
                        "name": "Catalyst Temperature Delta",
                        "type": "CALCULATED",
                        "key": "obd.calculated[catalyst_delta_temp]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "\u00b0C",
                        "params": "last(//obd[catalyst_temp_b1s1]) - last(//obd[coolant_temp])"
                    },
                    {
                        "uuid": "fc307bea7cdc4d28bc491cdf8941f959",
                        "name": "Estimated Engine Power",
                        "type": "CALCULATED",
                        "key": "obd.calculated[engine_power_kw]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "kW",
                        "params": "last(//obd[absolute_load]) / 100 * 55.9"
                    },
                    {
                        "uuid": "98ae8f5a01284a1c8caac9eb56a81664",
                        "name": "Engine Thermal Rise",
                        "type": "CALCULATED",
                        "key": "obd.calculated[engine_thermal_rise]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "\u00b0C",
                        "params": "last(//obd[coolant_temp]) - last(//obd[ambiant_air_temp])"
                    },
                    {
                        "uuid": "4b84752588c84200b915855c0b01112b",
                        "name": "Instantaneous Fuel Economy",
                        "type": "CALCULATED",
                        "key": "obd.calculated[fuel_economy_kml]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "km/L",
                        "params": "last(//obd[speed]) / (((last(//obd[intake_pressure]) * last(//obd[rpm]) * ({$OBD.ENGINE.DISPLACEMENT} * {$OBD.ENGINE.VE} * 3825)) / (25660.2 * (last(//obd[intake_temp]) + 273.15) * (14.7 - 5.7 * last(//obd[ethanol_percent]) / 100) * (last(//obd[commanded_equiv_ratio]) + 0.001))) + 0.001)"
                    },
                    {
                        "uuid": "fcce06249c9547d3a9f78c7dc111a034",
                        "name": "Fuel Consumption Rate",
                        "type": "CALCULATED",
                        "key": "obd.calculated[fuel_flow_lh]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "L/h",
                        "params": "(last(//obd[intake_pressure]) * last(//obd[rpm]) * ({$OBD.ENGINE.DISPLACEMENT} * {$OBD.ENGINE.VE} * 3825)) / (25660.2 * (last(//obd[intake_temp]) + 273.15) * (14.7 - 5.7 * last(//obd[ethanol_percent]) / 100) * (last(//obd[commanded_equiv_ratio]) + 0.001))"
                    },
                    {
                        "uuid": "6bb07eecc1444e91b29e65c1a1d40e06",
                        "name": "Intake Manifold Vacuum",
                        "type": "CALCULATED",
                        "key": "obd.calculated[manifold_vacuum]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "kPa",
                        "params": "last(//obd[barometric_pressure]) - last(//obd[intake_pressure])"
                    },
                    {
                        "uuid": "e51816679e0c4d0c97f73f85e13113c5",
                        "name": "Engine Run Time",
                        "type": "CALCULATED",
                        "key": "obd.calculated[run_time_min]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "min",
                        "params": "last(//obd[run_time]) / 60"
                    },
                    {
                        "uuid": "fd42e1bb1e5940a39af45e7325f37bbb",
                        "name": "Total Fuel Trim",
                        "type": "CALCULATED",
                        "key": "obd.calculated[total_fuel_trim]",
                        "delay": "10s",
                        "history": "180d",
                        "value_type": "FLOAT",
                        "units": "%",
                        "params": "last(//obd[short_fuel_trim_1]) + last(//obd[long_fuel_trim_1])"
                    }
                ],
                "discovery_rules": [
                    {
                        "uuid": "2ff7e51f226a4e4a876513ac8456eb04",
                        "name": "OBD2 PID Discovery",
                        "type": "TRAP",
                        "key": "obd.discovery",
                        "delay": "0",
                        "lifetime": "30d",
                        "description": "Automatically discovers all OBD2 PIDs supported by the ECU.\n\nThe telemetry.py script sends the discovery payload upon connection and every hour.\n\nAvailable macros:\n  {#OBD_KEY}  \u2014 key suffix (e.g. rpm, speed, coolant_temp)\n  {#OBD_NAME} \u2014 readable name (e.g. Engine RPM)\n  {#OBD_UNIT} \u2014 measurement unit (e.g. rpm, km/h, \u00b0C)",
                        "item_prototypes": [
                            {
                                "uuid": "f83d8a5f9e274ecc919232b2ed634e73",
                                "name": "{#OBD_NAME}",
                                "type": "TRAP",
                                "key": "obd[{#OBD_KEY}]",
                                "delay": "0",
                                "history": "180d",
                                "value_type": "FLOAT",
                                "units": "{#OBD_UNIT}",
                                "description": "{#OBD_DESC}",
                                "tags": [
                                    {
                                        "tag": "component",
                                        "value": "obd2"
                                    },
                                    {
                                        "tag": "pid",
                                        "value": "{#OBD_KEY}"
                                    },
                                    {
                                        "tag": "source",
                                        "value": "ecu"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "ba9f45379ab142a28f317cca7a00ebc0",
                                        "expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])=0",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])=1",
                                        "name": "Emission monitor failed: {#OBD_NAME}",
                                        "priority": "AVERAGE",
                                        "description": "Emission monitor returned 0 (failed or incomplete).\n1 = passed / 0 = failed or not completed.\nPID: obd[{#OBD_KEY}]",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "availability"
                                            },
                                            {
                                                "tag": "type",
                                                "value": "emission_monitor"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "ebe09a9a8f7647c898b17c243f961a6b",
                                        "expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])>{$OBD.CATALYST.HIGH}",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])<{$OBD.CATALYST.HIGH.RECOVERY}",
                                        "name": "Excessive catalyst temperature: {#OBD_NAME} ({ITEM.LASTVALUE})",
                                        "priority": "HIGH",
                                        "description": "Catalyst temperature above {$OBD.CATALYST.HIGH} \u00b0C.\nNormal operating range: 400-900 \u00b0C.\nAbove {$OBD.CATALYST.HIGH} \u00b0C may indicate overload or fuel system issues.\nRecovery: below {$OBD.CATALYST.HIGH.RECOVERY} \u00b0C.\nPID: obd[{#OBD_KEY}]",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "availability"
                                            },
                                            {
                                                "tag": "type",
                                                "value": "temperature"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "f4f613d853174a7f8aef616b02928ec3",
                                        "expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])>{$OBD.RPM.HIGH}",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])<{$OBD.RPM.HIGH.RECOVERY}",
                                        "name": "High RPM: {#OBD_NAME} ({ITEM.LASTVALUE}rpm)",
                                        "priority": "AVERAGE",
                                        "description": "Engine rotation above {$OBD.RPM.HIGH} RPM.\nRecovery: below {$OBD.RPM.HIGH.RECOVERY} RPM.\n\nPID: obd[{#OBD_KEY}]",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "performance"
                                            },
                                            {
                                                "tag": "type",
                                                "value": "rpm"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "ec39523e38f14634ac87c4972daef336",
                                        "expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])>{$OBD.TEMP.HIGH}",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])<{$OBD.TEMP.HIGH.RECOVERY}",
                                        "name": "High temperature: {#OBD_NAME} ({ITEM.LASTVALUE})",
                                        "priority": "HIGH",
                                        "description": "Thermal sensor above {$OBD.TEMP.HIGH}\u00b0C.\nRecovery: below {$OBD.TEMP.HIGH.RECOVERY}\u00b0C.\n\nPID: obd[{#OBD_KEY}]",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "availability"
                                            },
                                            {
                                                "tag": "type",
                                                "value": "temperature"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "63a8d61a0bc849d1bba5cc47bcda97ec",
                                        "expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])<{$OBD.VOLTAGE.LOW}",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])>{$OBD.VOLTAGE.LOW.RECOVERY}",
                                        "name": "Low voltage: {#OBD_NAME} ({ITEM.LASTVALUE}V)",
                                        "priority": "WARNING",
                                        "description": "Control module voltage below {$OBD.VOLTAGE.LOW}V.\nPossible alternator or battery issue.\nRecovery: above {$OBD.VOLTAGE.LOW.RECOVERY}V.\n\nPID: obd[{#OBD_KEY}]",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "availability"
                                            },
                                            {
                                                "tag": "type",
                                                "value": "voltage"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "dd11937ecb9f4ffbaab3442f7db2bd91",
                                        "expression": "timeleft(/Generic Telemetry by OBD2/obd[{#OBD_KEY}],30m,,10)<2h and last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])>10",
                                        "name": "Predictive: Fuel tank reaching reserve (10%) in less than 2 hours",
                                        "priority": "INFO",
                                        "description": "Calculates the rate of fuel consumption over the last 30 minutes and predicts when it will reach 10%.",
                                        "status": "1",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "predictive"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "d576ed0c6a2f4ee3969ec191d87edf4a",
                                        "expression": "forecast(/Generic Telemetry by OBD2/obd[{#OBD_KEY}],10m,,10m)>115",
                                        "name": "Predictive: Engine Overheating (Temp > 115C) predicted in 10 mins",
                                        "priority": "HIGH",
                                        "description": "Analyzes temperature slope over the last 10 minutes to forecast if it will exceed 115C in the next 10 minutes.",
                                        "status": "1",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "predictive"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "e1464e59200c44c18b9a27eb615cfdaf",
                                        "expression": "timeleft(/Generic Telemetry by OBD2/obd[{#OBD_KEY}],15m,,11.0)<30m and last(/Generic Telemetry by OBD2/obd[{#OBD_KEY}])<12.5",
                                        "name": "Predictive: Battery drain. Voltage will hit 11.0V in less than 30 mins",
                                        "priority": "WARNING",
                                        "description": "Analyzes voltage drop over the last 15 minutes. Predicts alternator failure or severe battery drain.",
                                        "status": "1",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "predictive"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "077154acb70a490b8140168e62f410ad",
                                        "expression": "forecast(/Generic Telemetry by OBD2/obd[{#OBD_KEY}],30d,,30d)>25 or forecast(/Generic Telemetry by OBD2/obd[{#OBD_KEY}],30d,,30d)<-25",
                                        "name": "Predictive: Long Term Fuel Trim will exceed +-25% in 30 days",
                                        "priority": "WARNING",
                                        "description": "Analyzes the trend of LTFT over a month. Predicts if dirty injectors or a vacuum leak will trigger a Check Engine Light soon.",
                                        "status": "1",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "predictive"
                                            }
                                        ]
                                    },
                                    {
                                        "uuid": "6591e3e7a2df4bf9a4b7222d3d9307bd",
                                        "expression": "timeleft(/Generic Telemetry by OBD2/obd[{#OBD_KEY}],7d,,10000)<30d",
                                        "name": "Predictive: 10,000 km maintenance milestone in less than 30 days",
                                        "priority": "INFO",
                                        "description": "Analyzes driving habits to predict when the car will hit 10,000 km since the last DTC clear (assuming oil change sync).",
                                        "status": "1",
                                        "tags": [
                                            {
                                                "tag": "scope",
                                                "value": "predictive"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ],
                        "graph_prototypes": [
                            {
                                "uuid": "06f9b02fe587410c885dab85f3599ffb",
                                "name": "OBD2: {#OBD_NAME}",
                                "graph_items": [
                                    {
                                        "drawtype": "BOLD_LINE",
                                        "color": "1A7C11",
                                        "item": {
                                            "host": "Generic Telemetry by OBD2",
                                            "key": "obd[{#OBD_KEY}]"
                                        }
                                    }
                                ]
                            }
                        ],
                        "overrides": [
                            {
                                "name": "Enable temperature trigger for thermal sensors",
                                "step": "1",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "coolant_temp|intake_temp|ambient_air_temp|oil_temp",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "High temperature",
                                        "status": "ENABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Disable temperature trigger for non-thermal sensors",
                                "step": "2",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "coolant_temp|intake_temp|ambient_air_temp|oil_temp",
                                            "operator": "NOT_MATCHES_REGEX",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "High temperature",
                                        "status": "DISABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Enable voltage trigger only for control_module_voltage",
                                "step": "3",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "control_module_voltage",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "Low voltage",
                                        "status": "ENABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Disable voltage trigger for non-voltage sensors",
                                "step": "4",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "control_module_voltage",
                                            "operator": "NOT_MATCHES_REGEX",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "Low voltage",
                                        "status": "DISABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Enable RPM trigger only for rpm",
                                "step": "5",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "^rpm$",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "High RPM",
                                        "status": "ENABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Disable RPM trigger for non-rpm sensors",
                                "step": "6",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "^rpm$",
                                            "operator": "NOT_MATCHES_REGEX",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "High RPM",
                                        "status": "DISABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Enable monitor trigger only for monitor_*",
                                "step": "7",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "^monitor_",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "Emission monitor failed",
                                        "status": "ENABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Disable monitor trigger for non-monitor_*",
                                "step": "8",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "^monitor_",
                                            "operator": "NOT_MATCHES_REGEX",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "Emission monitor failed",
                                        "status": "DISABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Enable catalyst trigger only for catalyst_temp",
                                "step": "9",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "^catalyst_temp",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "Excessive catalyst temperature",
                                        "status": "ENABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Disable catalyst trigger for non-catalyst_temp",
                                "step": "10",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "^catalyst_temp",
                                            "operator": "NOT_MATCHES_REGEX",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
                                    {
                                        "operationobject": "TRIGGER_PROTOTYPE",
                                        "operator": "LIKE",
                                        "value": "Excessive catalyst temperature",
                                        "status": "DISABLED"
                                    }
                                ]
                            },
                            {
                                "name": "Predictive: Enable Fuel Level",
                                "step": "11",
                                "filter": {
                                    "evaltype": "AND",
                                    "conditions": [
                                        {
                                            "macro": "{#OBD_KEY}",
                                            "value": "fuel_level",
                                            "formulaid": "A"
                                        }
                                    ]
                                },
                                "operations": [
